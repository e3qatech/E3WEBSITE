{
  "name": "E3 Website",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22.14.0",
      "pnpmVersion": "9.1.0"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      },
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "Prisma.prisma"
      ]
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js",
      "onAutoForward": "notify"
    }
  },
  "onCreateCommand": "corepack enable && pnpm install --frozen-lockfile",
  "updateContentCommand": "pnpm turbo run db:generate",
  "postCreateCommand": "echo 'Codespace ready. Run pnpm dlx vercel link to connect environment variables.'"
}
