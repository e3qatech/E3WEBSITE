{
  "name": "e3-qatar",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo run db:generate",
    "db:seed": "turbo run db:seed",
    "verify:install": "pnpm install --frozen-lockfile",
    "verify:prisma": "pnpm --filter web exec prisma generate",
    "verify:typecheck": "pnpm --filter web exec tsc --noEmit",
    "verify:test": "pnpm --filter web run test:all",
    "verify:lint": "node scripts/check-lint-budget.js",
    "verify:security": "node scripts/security-check.js",
    "verify:audit": "node scripts/audit-report.js",
    "verify:build": "pnpm turbo run build",
    "verify:all": "pnpm verify:prisma && pnpm verify:typecheck && pnpm verify:test && pnpm verify:lint && pnpm verify:security && pnpm verify:build",
    "test:gate02": "pnpm --filter web run test:gate02",
    "test:gate03": "pnpm --filter web run test:gate03",
    "test:gate04": "pnpm --filter web run test:gate04",
    "test:gate05": "pnpm --filter web run test:gate05",
    "test:gate06": "pnpm --filter web run test:gate06",
    "test:all": "pnpm --filter web run test:all"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "prettier": "^3.2.5",
    "turbo": "latest",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "three": "^0.185.0"
  }
}
