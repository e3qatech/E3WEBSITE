  // Contact Info
  customerName  String
  companyOrOrg  String?
  email         String
  phone         String?
  whatsApp      String?
  contactMethod String  @default("WHATSAPP") // PHONE, EMAIL, WHATSAPP

  // Event Details
  celebrationName   String?
  ageGroup          String?
  preferredDate     DateTime?
  alternativeDate   DateTime?
  preferredTimeSlot String?
  expectedGuests    Int       @default(10)
  expectedChildren  Int?
  expectedAdults    Int?
  estimatedValue    Float?

  // Package Selection
  packageId        String?
  package          Package? @relation(fields: [packageId], references: [id])
