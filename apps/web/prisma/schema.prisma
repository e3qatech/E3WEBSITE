model Location {
  id                 String    @id @default(cuid())
  slug               String?   @unique
  nameEn             String
  nameAr             String
  venueEn            String?
  venueAr            String?
  addressEn          String?
  addressAr          String?
  shortDescriptionEn String?
  shortDescriptionAr String?
  googleMapsUrl      String?
  directionsUrl      String?
  latitude           Float?
  longitude          Float?
  locationType       String    @default("PERMANENT_ATTRACTION") // PERMANENT_ATTRACTION, MALL_ACTIVATION, SEASONAL_ATTRACTION, EVENT, ACTIVE_PROJECT, PAST_PROJECT, OFFICE, OTHER
  operationalStatus  String    @default("OPEN") // OPEN, COMING_SOON, TEMPORARILY_CLOSED, SEASONAL, ENDED, INACTIVE
  status             String    @default("OPEN")
  openingDate        DateTime?
  closingDate        DateTime?
  generalHours       Json?
  timingRules        Json?
  ticketingUrl       String?
  phone              String?
  email              String?
  whatsapp           String?
  chatLink           String?
  timezone           String    @default("Asia/Qatar")
  coverMediaUrl      String?
  thumbnailMediaId   String?
  mapPinMediaId      String?
  pinColorToken      String    @default("CYAN")
  featured           Boolean   @default(false)
  mapVisible         Boolean   @default(true)
  publicationStatus  String    @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
