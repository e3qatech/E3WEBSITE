model AttractionLocation {
  id                    String   @id @default(cuid())
  attractionId          String
  locationId            String
  isPrimary             Boolean  @default(false)
  mapVisible            Boolean  @default(true)
  availabilityStatus    String?  @default("AVAILABLE")
  openingHoursOverride  Json?
  bookingUrlOverride    String?
  startingPriceOverride Float?
  currency              String   @default("QAR")
  shortLabelEn          String?
  shortLabelAr          String?
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attraction Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  location   Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([attractionId, locationId])
  @@index([attractionId])
  @@index([locationId])
}

model BrandPlacement {
