generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pages {
  id        String     @id @default(cuid())
  slug      String     @unique
  title     Json?
  content   Json?
  seo       Json?
  status    PageStatus @default(DRAFT)
  portal    PortalType @default(SHARED)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@index([portal])
}

model Media {
  id           String    @id @default(cuid())
  url          String
  thumbnailUrl String?
  type         MediaType
  mimeType     String
  size         Int
  alt          Json?
  metadata     Json?
  uploadedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String?          @unique
  emailVerified   DateTime?
  password        String?
  image           String?
  role            RoleType         @default(CLIENT)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessionVersion  Int              @default(1)
  accounts        Account[]
  jobApplications JobApplication[]
  sessions        Session[]
  systemLogs      SystemLog[]
  packageLeads    PackageLead[]
}

model JobApplication {
  id           String     @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  jobTitle     String
  department   String?
  cvUrl        String
  cvParsedData Json?
  status       String     @default("NEW")
  portal       PortalType @default(SHARED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([portal])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Attraction {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  nameEn           String
  nameAr           String
  taglineEn        String?
  taglineAr        String?
  descriptionEn    String?
  descriptionAr    String?
  coordinates      Json?
  isPublished      Boolean                  @default(false)
  isFeatured       Boolean                  @default(false)
  isHidden         Boolean                  @default(false)
  heroMediaType    String                   @default("IMAGE")
  heroMediaUrl     String?
  heroFallbackUrl  String?
  heroThumbnailUrl String?
  mapUrl           String?
  ticketingUrl     String?
  features         Json?
  partnerOffers    Json?
  partners         Json?
  socialPreviews   Json?
  newsCoverage     Json?
  operations       Json?
  temporalStatus   Json?
  testimonials     Json?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  logoUrl          String?
  seo              Json?
  featuresList     AttractionFeature[]
  faqs             AttractionFaq[]
  gallery          AttractionGalleryItem[]
  offers           AttractionOffer[]
  pricing          AttractionPricing[]
  socialLinks      AttractionSocialLink[]
  temporalRules    AttractionTemporalRule[]
  calendarEvents   CalendarEvent[]
  caseStudies      CaseStudy[]
  schedules        EventSchedule[]
  feedbacks        Feedback[]
  services         Service[]
  serviceProjects  ServiceProject[]
  telemetry        TelemetryLog[]
  locations        Location[]
  brandPlacements  BrandPlacement[]
  packages         Package[]

  @@index([isPublished, isHidden])
}

model AttractionPricing {
  id            String     @id @default(cuid())
  attractionId  String
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  price         Float
  discount      Float?
  currency      String     @default("QAR")
  type          String     @default("GENERAL")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  attraction    Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([attractionId])
}

model AttractionOffer {
  id           String     @id @default(cuid())
  attractionId String
  code         String     @unique
  discount     Float
  validUntil   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([attractionId])
  @@index([code])
}

model AttractionFaq {
  id           String     @id @default(cuid())
  attractionId String
  questionEn   String
  questionAr   String
  answerEn     String
  answerAr     String
  orderIndex   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([attractionId])
}

model AttractionGalleryItem {
  id           String     @id @default(cuid())
  attractionId String
  url          String
  captionEn    String?
  captionAr    String?
  orderIndex   Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([attractionId])
}

model AttractionSocialLink {
  id           String     @id @default(cuid())
  attractionId String
  platform     String
  url          String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([attractionId])
}

model AttractionTemporalRule {
  id           String     @id @default(cuid())
  attractionId String
  ruleType     String
  startDate    DateTime?
  endDate      DateTime?
  openTime     String?
  closeTime    String?
  daysOfWeek   Json?
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([attractionId])
}

model EventSchedule {
  id            String     @id @default(cuid())
  attractionId  String
  startTime     DateTime
  endTime       DateTime
  eventType     String     @default("REGULAR")
  capacityGate  Int        @default(100)
  currentCount  Int        @default(0)
  description   String?
  heroMediaType String     @default("IMAGE")
  heroMediaUrl  String?
  title         String?
  attraction    Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([startTime, endTime])
}

model TelemetryLog {
  id           String     @id @default(cuid())
  attractionId String
  sensorId     String
  payload      Json
  healthStatus String     @default("OK")
  timestamp    DateTime   @default(now())
  attraction   Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([timestamp])
  @@index([healthStatus])
}

model Service {
  id                 String               @id @default(cuid())
  slug               String               @unique
  titleEn            String
  titleAr            String
  taglineEn          String?
  taglineAr          String?
  thumbnail          String?
  contentEn          String?
  contentAr          String?
  isFeatured         Boolean              @default(false)
  isVisible          Boolean              @default(false)
  isPublished        Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  heroMediaType      String               @default("IMAGE")
  heroMediaUrl       String?
  process            Json?
  ctaPrimary         String               @default("CONTACT")
  ctaSecondary       String?
  seo                Json?
  attractionId       String?
  category           String?
  successMetricLabel String?
  successMetricValue String?
  attraction         Attraction?          @relation(fields: [attractionId], references: [id])
  gallery            ServiceGalleryItem[]
  projects           ServiceProject[]

  @@index([isVisible])
  @@index([isFeatured])
}

model ServiceGalleryItem {
  id         String   @id @default(cuid())
  serviceId  String
  url        String
  captionEn  String?
  captionAr  String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([orderIndex])
}

model ServiceProject {
  id            String      @id @default(cuid())
  serviceId     String
  titleEn       String
  titleAr       String
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  attractionId  String?
  attraction    Attraction? @relation(fields: [attractionId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([attractionId])
}

model CaseStudy {
  id                 String                @id @default(cuid())
  slug               String                @unique
  titleEn            String
  titleAr            String
  clientName         String                @default("Unknown Client")
  year               Int                   @default(2024)
  category           String                @default("Corporate")
  isFeatured         Boolean               @default(false)
  heroImageUrl       String?
  thumbnailUrl       String?
  clientLogoUrl      String?
  challengeEn        String?
  challengeAr        String?
  solutionEn         String?
  solutionAr         String?
  metrics            Json?
  gallery            Json?
  beforeAfter        Json?
  servicesUsed       Json?
  technicalSpecs     Json?
  isPublished        Boolean               @default(false)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  attractionId       String?
  testimonials       Json?
  heroMediaType      String?               @default("IMAGE")
  thumbnailMediaType String?               @default("IMAGE")
  seo                Json?
  attraction         Attraction?           @relation(fields: [attractionId], references: [id])
  teamMembers        CaseStudyTeamMember[]

  @@index([isPublished])
  @@index([category])
  @@index([year])
  @@index([attractionId])
}

model CaseStudyTeamMember {
  id                String          @id @default(cuid())
  caseStudyId       String
  roleEn            String?
  roleAr            String?
  orderIndex        Int             @default(0)
  employeeProfileId String
  caseStudy         CaseStudy       @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([caseStudyId])
  @@index([employeeProfileId])
}

model Lead {
  id               String         @id @default(cuid())
  name             String
  company          String?
  email            String
  phone            String?
  status           LeadStatus     @default(NEW)
  value            Float?
  probability      Int?
  assignedToId     String?
  interestServices Json?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  inquiries        Inquiry[]
  activities       LeadActivity[]

  @@index([status])
}

model LeadActivity {
  id          String   @id @default(cuid())
  type        String
  description String
  author      String
  leadId      String
  timestamp   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model AvailabilitySlot {
  id                String          @id @default(cuid())
  startTime         DateTime
  endTime           DateTime
  isBooked          Boolean         @default(false)
  employeeProfileId String
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([startTime, endTime])
  @@index([isBooked])
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  isVirtual   Boolean  @default(true)
  location    String?
  meetingLink String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startTime, endTime])
}

model Talent {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String?
  position        String?
  department      String?
  experienceLevel String?
  status          String   @default("NEW")
  rating          Int?
  appliedDate     DateTime @default(now())
  resumeUrl       String?
  skills          Json?
  languages       Json?
  education       Json?
  certifications  Json?
  assignedToId    String?
  notes           String?
  jobId           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  job             Job?     @relation(fields: [jobId], references: [id])
}

model Job {
  id           String   @id @default(cuid())
  title        String
  department   String?
  location     String?
  type         String   @default("FULL_TIME")
  description  String
  requirements String?
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications Talent[]
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  website     String?
  category    String   @default("TECHNOLOGY")
  description String?
  logoUrl     String?
  isVisible   Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  type      String   @default("GENERAL")
  updatedAt DateTime @updatedAt

  @@index([type])
}

model CalendarEvent {
  id           String          @id @default(cuid())
  title        String
  description  String?
  attractionId String?
  status       String          @default("DRAFT")
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  attraction   Attraction?     @relation(fields: [attractionId], references: [id])
  timeSlots    EventTimeSlot[]

  @@index([attractionId])
}

model EventTimeSlot {
  id            String        @id @default(cuid())
  eventId       String
  startTime     DateTime
  endTime       DateTime
  capacity      Int           @default(100)
  priceOverride Float?
  status        String        @default("AVAILABLE")
  event         CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model SystemBroadcast {
  id        String   @id @default(cuid())
  titleEn   String
  titleAr   String
  messageEn String
  messageAr String
  isActive  Boolean  @default(true)
  type      String   @default("INFO")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model RecapReport {
  id        String   @id @default(cuid())
  eventName String
  date      DateTime
  metrics   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([action])
}

model Client {
  id            String   @id @default(cuid())
  company       String
  type          String   @default("B2B")
  industry      String?
  website       String?
  assignedRepId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
}

model Inquiry {
  id           String   @id @default(cuid())
  type         String
  subject      String?
  name         String
  email        String
  phone        String?
  message      String
  status       String   @default("NEW")
  leadId       String?
  assignedToId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lead         Lead?    @relation(fields: [leadId], references: [id])

  @@index([type])
  @@index([status])
}

model Feedback {
  id           String      @id @default(cuid())
  title        String?
  name         String?
  email        String?
  message      String
  rating       Int?
  status       String      @default("NEW")
  isFeatured   Boolean     @default(false)
  attractionId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  attraction   Attraction? @relation(fields: [attractionId], references: [id])

  @@index([attractionId])
}

model Subscriber {
  id          String    @id @default(cuid())
  email       String?   @unique
  phone       String?   @unique
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  token       String?   @unique
  preferences Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isVerified])
}

model EmployeeProfile {
  id                String                @id @default(cuid())
  slug              String                @unique
  firstName         String
  lastName          String
  designation       String
  department        String
  yearsOfExperience Int
  tagline           String
  profileImage      String?
  aboutSummary      String
  careerJourney     String
  keyStrengths      String
  expertiseTags     Json
  coreCompetencies  Json
  experience        Json
  projects          Json
  certifications    Json
  education         Json
  awards            Json
  skillsMatrix      Json
  mediaGallery      Json
  testimonials      Json
  contactEmail      String?
  linkedinUrl       String?
  isActive          Boolean               @default(true)
  order             Int                   @default(0)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  aboutSummaryAr    String?
  designationAr     String?
  firstNameAr       String?
  lastNameAr        String?
  availability      AvailabilitySlot[]
  caseStudies       CaseStudyTeamMember[]
  insights          Insight[]

  @@index([department])
  @@index([isActive])
}

enum RoleType {
  SUPER_ADMIN
  SALES_ADMIN
  SUPPORT_ADMIN
  STAFF
  CLIENT
  CANDIDATE
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum PortalType {
  B2B
  B2C
  SHARED
}

enum MediaType {
  IMAGE
  VIDEO
  MODEL_3D
  DOCUMENT
  IFRAME
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
}

model StoryType {
  id             String              @id @default(cuid())
  slug           String              @unique
  titleEn        String
  titleAr        String
  descriptionEn  String?
  descriptionAr  String?
  icon           String?
  coverMediaUrl  String?
  coverMediaType String              @default("IMAGE")
  accentColor    String?
  orderIndex     Int                 @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  features       AttractionFeature[]

  @@index([isActive])
}

model AttractionFeature {
  id            String      @id @default(cuid())
  attractionId  String
  titleEn       String
  titleAr       String?
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  orderIndex    Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  attraction    Attraction  @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  storyTypes    StoryType[]

  iconUrl          String?
  highlightType    String      @default("ACTIVITY")
  linkedBrandId    String?
  linkedBrand      BrandIP?    @relation(fields: [linkedBrandId], references: [id])
  showBrandLogo    Boolean     @default(false)
  logoVariant      String      @default("AUTO")
  ctaLabelEn       String?
  ctaLabelAr       String?
  ctaUrl           String?
  startDate        DateTime?
  endDate          DateTime?
  availableAt      Location[]

  @@index([attractionId])
}

model BrandCategory {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameAr    String
  brands    BrandIP[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model BrandRelationshipType {
  id        String    @id @default(cuid())
  slug      String    @unique
  labelEn   String
  labelAr   String
  brands    BrandIP[]
}

model BrandIP {
  id                     String    @id @default(cuid())
  slug                   String    @unique
  nameEn                 String
  nameAr                 String
  taglineEn              String?
  taglineAr              String?
  shortDescriptionEn     String?
  shortDescriptionAr     String?
  fullStoryEn            String?
  fullStoryAr            String?
  launchYear             Int?
  parentEntity           String?
  isActive               Boolean   @default(true)
  lifecycleStatus        String    @default("ACTIVE") // ACTIVE, COMING_SOON, SEASONAL, INACTIVE, LEGACY

  // Logo System
  primaryLogoUrl         String?
  lightLogoUrl           String?
  darkLogoUrl            String?
  compactLogoUrl         String?
  logoAltEn              String?
  logoAltAr              String?

  // Media
  mediaType              String    @default("IMAGE")
  primaryMediaUrl        String?
  coverMediaUrl          String?
  detailMediaUrl         String?
  fallbackImageUrl       String?
  thumbnailUrl           String?
  mediaGallery           Json?
  mediaAltEn             String?
  mediaAltAr             String?

  // Taxonomies
  categoryId             String?
  category               BrandCategory? @relation(fields: [categoryId], references: [id])
  relationships          BrandRelationshipType[]
  primaryRelationshipId  String?

  // B2C Presentation
  showOnB2C              Boolean   @default(true)
  showInWorldsCreated    Boolean   @default(true)
  featureOnB2C           Boolean   @default(false)
  b2cDisplayOrder        Int       @default(0)
  b2cTitleOverrideEn     String?
  b2cTitleOverrideAr     String?
  b2cShortDescOverrideEn String?
  b2cShortDescOverrideAr String?
  b2cDetailCopyEn        String?
  b2cDetailCopyAr        String?
  b2cCtaLabelEn          String?
  b2cCtaLabelAr          String?
  b2cCtaUrl              String?

  // B2B Presentation
  showOnB2B              Boolean   @default(true)
  showInB2BPortfolio     Boolean   @default(true)
  featureOnB2B           Boolean   @default(false)
  b2bDisplayOrder        Int       @default(0)
  b2bBusinessOverviewEn  String?
  b2bBusinessOverviewAr  String?
  b2bBusinessValueEn     String?
  b2bBusinessValueAr     String?
  b2bCapabilitiesEn      String?
  b2bCapabilitiesAr      String?
  b2bCtaLabelEn          String?
  b2bCtaLabelAr          String?
  b2bInquiryUrl          String?

  placements             BrandPlacement[]
  linkedHighlights       AttractionFeature[]
  packages               Package[]
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model Location {
  id               String   @id @default(cuid())
  nameEn           String
  nameAr           String
  venueEn          String?
  venueAr          String?
  addressEn        String?
  addressAr        String?
  googleMapsUrl    String?
  latitude         Float?
  longitude        Float?
  status           String   @default("OPEN")
  openingDate      DateTime?
  closingDate      DateTime?
  generalHours     Json?
  timingRules      Json?
  ticketingUrl     String?
  phone            String?
  email            String?
  whatsapp         String?
  chatLink         String?
  coverMediaUrl    String?
  displayOrder     Int      @default(0)
  isPrimary        Boolean  @default(false)
  isPublished      Boolean  @default(true)
  
  attractionId     String?
  attraction       Attraction? @relation(fields: [attractionId], references: [id])
  
  placements       BrandPlacement[]
  highlightAvailabilities AttractionFeature[]
  packages         Package[]
}

model BrandPlacement {
  id           String    @id @default(cuid())
  brandId      String
  attractionId String
  role         String    @default("HOSTED_EXPERIENCE") // PRIMARY_BRAND, SUB_BRAND, etc.
  displayOrder Int       @default(0)
  isVisible    Boolean   @default(true)
  startDate    DateTime?
  endDate      DateTime?
  
  brand        BrandIP    @relation(fields: [brandId], references: [id])
  attraction   Attraction @relation(fields: [attractionId], references: [id])
  locations    Location[]

  @@unique([brandId, attractionId, role])
}

model Insight {
  id                      String           @id @default(cuid())
  contentType             String           @default("ARTICLE") // ARTICLE, NEWS, PRESS_RELEASE, EVENT_RECAP, TECHNICAL_INSIGHT, ANNOUNCEMENT, MEDIA_UPDATE
  titleEn                 String
  titleAr                 String?
  slugEn                  String           @unique
  slugAr                  String?          @unique
  excerptEn               String?
  excerptAr               String?
  bodyEn                  String?
  bodyAr                  String?
  featuredMediaId         String?
  mobileMediaId           String?
  galleryMediaIds         Json?
  videoMediaId            String?
  authorEmployeeProfileId String?
  categoryId              String?
  tagIds                  Json?
  relatedProjectIds       Json?
  relatedCaseStudyIds     Json?
  relatedServiceIds       Json?
  relatedAttractionIds    Json?
  relatedPartnerIds       Json?
  relatedClientIds        Json?
  sourceLabel             String?
  sourceUrl               String?
  publishStatus           String           @default("DRAFT") // DRAFT, IN_REVIEW, SCHEDULED, PUBLISHED, ARCHIVED
  publishedAt             DateTime?
  scheduledAt             DateTime?
  expiresAt               DateTime?
  featured                Boolean          @default(false)
  restricted              Boolean          @default(false)
  sortOrder               Int              @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  createdBy               String?
  updatedBy               String?

  // SEO Fields
  metaTitleEn             String?
  metaTitleAr             String?
  metaDescriptionEn       String?
  metaDescriptionAr       String?
  canonicalUrlEn          String?
  canonicalUrlAr          String?
  ogTitleEn               String?
  ogTitleAr               String?
  ogDescriptionEn         String?
  ogDescriptionAr         String?
  ogImageMediaId          String?
  twitterTitleEn          String?
  twitterTitleAr          String?
  twitterDescriptionEn    String?
  twitterDescriptionAr    String?
  twitterImageMediaId     String?
  indexingDirective       String?          @default("INDEX_FOLLOW")
  focusTopicEn            String?
  focusTopicAr            String?
  secondaryTopicsEn       Json?
  secondaryTopicsAr       Json?

  author                  EmployeeProfile? @relation(fields: [authorEmployeeProfileId], references: [id])

  @@index([publishStatus])
  @@index([contentType])
  @@index([publishedAt])
  @@index([featured])
}

model Package {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  code                  String?       @unique
  titleEn               String
  titleAr               String?
  taglineEn             String?
  taglineAr             String?
  shortDescriptionEn    String?
  shortDescriptionAr    String?
  fullDescriptionEn     String?
  fullDescriptionAr     String?
  category              String        @default("BIRTHDAY") // BIRTHDAY, GROUP, SCHOOL, CORPORATE, PRIVATE_EVENT, CUSTOM
  audienceType          String        @default("KIDS")     // KIDS, TEENS, ADULTS, FAMILIES, CORPORATE, ALL_AGES
  coverMediaUrl         String?
  heroMediaUrl          String?
  heroMediaType         String        @default("IMAGE")
  brochureUrl           String?
  startingPrice         Float         @default(0)
  priceDisplayMode      String        @default("STARTING_FROM") // STARTING_FROM, FIXED, PRICE_ON_REQUEST, PER_GUEST
  currency              String        @default("QAR")
  minGuests             Int           @default(10)
  maxGuests             Int           @default(100)
  durationMinutes       Int           @default(120)
  ageSuitabilityEn      String?
  ageSuitabilityAr      String?
  indoorOutdoor         String        @default("INDOOR") // INDOOR, OUTDOOR, HYBRID
  badgeTextEn           String?
  badgeTextAr           String?
  availabilityStatus    String        @default("AVAILABLE") // AVAILABLE, LIMITED, SEASONAL, BY_REQUEST
  bookingType           String        @default("ENQUIRY_REQUIRED") // ENQUIRY_REQUIRED, INSTANT_BOOKING
  bookingQubeUrl        String?
  
  // Relations
  attractionId          String?
  attraction            Attraction?   @relation(fields: [attractionId], references: [id])
  brandId               String?
  brand                 BrandIP?      @relation(fields: [brandId], references: [id])
  locationId            String?
  location              Location?     @relation(fields: [locationId], references: [id])

  // Complex repeaters stored as JSON
  tiers                 Json?
  inclusions            Json?
  addOns                Json?
  journeySteps          Json?
  gallery               Json?
  testimonials          Json?
  faqs                  Json?
  termsConditions       Json?
  seo                   Json?

  isFeatured            Boolean       @default(false)
  isPublished           Boolean       @default(true)
  sortOrder             Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  leads                 PackageLead[]

  @@index([category])
  @@index([isPublished])
  @@index([isFeatured])
  @@index([attractionId])
}

model PackageLead {
  id                    String        @id @default(cuid())
  leadId                String        @unique @default(cuid())
  leadType              String        @default("BIRTHDAY") // BIRTHDAY, GROUP_SCHOOL, CORPORATE, GENERAL
  
  // Contact Info
  customerName          String
  companyOrOrg          String?
  email                 String
  phone                 String?
  whatsApp              String?
  contactMethod         String        @default("WHATSAPP") // PHONE, EMAIL, WHATSAPP

  // Event Details
  celebrationName       String?
  ageGroup              String?
  preferredDate         DateTime?
  alternativeDate       DateTime?
  preferredTimeSlot     String?
  expectedGuests        Int           @default(10)
  expectedChildren      Int?
  expectedAdults        Int?
  estimatedValue        Float?
  
  // Package Selection
  packageId             String?
  package               Package?      @relation(fields: [packageId], references: [id])
  selectedTierId        String?
  selectedTierName      String?
  selectedAddOns        Json?
  
  // Requirements & Notes
  themePreference       String?
  cateringRequirements  String?
  accessibilityReqs     String?
  specialRequests       String?
  attachments           Json?

  // Status & Tracking
  status                String        @default("NEW") // NEW, CONTACTED, QUALIFIED, AVAILABILITY_CHECK, QUOTATION_SENT, NEGOTIATION, DEPOSIT_PENDING, CONFIRMED, COMPLETED, LOST, SPAM
  priority              String        @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedToId          String?
  assignedTo            User?         @relation(fields: [assignedToId], references: [id])
  internalNotes         Json?
  sourcePage            String?
  utmSource             String?
  utmCampaign           String?
  locale                String        @default("en")

  // Legal Consents
  marketingConsent      Boolean       @default(false)
  termsAccepted         Boolean       @default(true)
  termsAcceptedAt       DateTime      @default(now())

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
  @@index([leadType])
  @@index([packageId])
}
